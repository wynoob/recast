    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@dmall/contracts": "workspace:*",
    "@dmall/domain": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
